# Server-side only. Never put model keys in frontend JavaScript.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Default for new web tasks. Each task saves its own selected model.
OPENROUTER_MODEL=qwen/qwen3.6-flash
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=
SERPER_API_KEY=
JINA_API_KEY=
NCBI_EMAIL=
# Set 1 only for a native loopback-only service (python -m studio.local sets it).
# Keep 0 for containers or remote deployments.
STUDIO_LOCAL_MODE=0
# Explicit opt-in: let visitors generate without an invitation code.
STUDIO_PUBLIC_MODE=0
# Access code required unless local or public mode is enabled. Choose a long random value.
STUDIO_ACCESS_TOKEN=
STUDIO_DATA_DIR=var/studio
STUDIO_JOB_TIMEOUT=1800
STUDIO_MAX_PENDING=5
# Set to 1 behind HTTPS to require secure session cookies.
STUDIO_SECURE_COOKIES=0
