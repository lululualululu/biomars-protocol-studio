# Server-side only. Never put model keys in frontend JavaScript.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional model override; otherwise use config/protocol/protocol_config.yaml.
OPENROUTER_MODEL=
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=
SERPER_API_KEY=
JINA_API_KEY=
NCBI_EMAIL=
# Access code required before starting a real job. Choose a long random value.
STUDIO_ACCESS_TOKEN=
STUDIO_DATA_DIR=var/studio
STUDIO_JOB_TIMEOUT=1800
STUDIO_MAX_PENDING=5
# Set to 1 behind HTTPS to require secure session cookies.
STUDIO_SECURE_COOKIES=0
